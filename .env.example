# Set this privately on your computer. Never share the bot token.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Empty = every server channel where this bot can read/send messages.
# Comma-separated IDs, for example: 123456789012345678,234567890123456789
ALLOWED_CHANNEL_IDS=

# Hide Discord's original automatic URL preview after all bot cards succeed.
# Requires Manage Messages; without it, the bot still sends its own card.
SUPPRESS_ORIGINAL_EMBEDS=true
MAX_LINKS_PER_MESSAGE=3
FETCH_TIMEOUT_MS=12000
CACHE_TTL_SECONDS=60

# Optional Discord custom emoji strings for closer icon matching.
# Example format: <:x_logo:123456789012345678>
EMOJI_REPLY=💬
EMOJI_REPOST=🔁
EMOJI_LIKE=❤️
EMOJI_X=𝕏
